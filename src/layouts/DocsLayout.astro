---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  section?: string;
}

const { title, description, section = "Documentation" } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
const currentPath = Astro.url.pathname;

const navigation = [
  { href: withBase("/docs/"), label: "Overview", match: "/docs/" },
  { href: withBase("/docs/for-users/"), label: "Use extensions", match: "/docs/for-users/" },
  { href: withBase("/docs/for-creators/"), label: "Publish extensions", match: "/docs/for-creators/" },
  { href: withBase("/docs/project-status/"), label: "Beta status", match: "/docs/project-status/" },
  { href: withBase("/docs/concepts/"), label: "Core concepts", match: "/docs/concepts/" },
  { href: withBase("/docs/registries/"), label: "Registries", match: "/docs/registries/" },
  { href: withBase("/docs/connectors/"), label: "Connectors", match: "/docs/connectors/" },
];
---

<BaseLayout title={`${title} — ExtensionMesh`} description={description} bodyClass="docs-page">
  <section class="docs-hero">
    <div class="shell">
      <p class="eyebrow">{section}</p>
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
  </section>

  <div class="shell docs-shell">
    <aside class="docs-sidebar" aria-label="Documentation navigation">
      <p>Documentation</p>
      <nav>
        {navigation.map((item) => (
          <a
            href={item.href}
            aria-current={
              item.match === "/docs/"
                ? currentPath === item.href || currentPath === item.href.slice(0, -1)
                  ? "page"
                  : undefined
                : currentPath.includes(item.match)
                  ? "page"
                  : undefined
            }
          >
            {item.label}
          </a>
        ))}
      </nav>
      <div class="sidebar-note">
        <span>Public beta</span>
        <p>Evaluate 0.1.0-beta.1 on Shopware 6.7 and review the current boundaries before production use.</p>
      </div>
    </aside>
    <article class="docs-content prose">
      <slot />
    </article>
  </div>
</BaseLayout>
