---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found — ExtensionMesh">
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1>This module is not connected.</h1>
    <p>The requested page does not exist or has moved.</p>
    <a class="button dark" href={base}>Return home <span aria-hidden="true">→</span></a>
  </section>
</BaseLayout>
