---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModuleDiagram from "../components/ModuleDiagram.astro";

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow on-dark"><span></span> Open project · Early development</p>
        <h1>Publish extensions. <em>Use them where they connect.</em></h1>
        <p class="hero-lead">
          ExtensionMesh connects independent extension sources with the
          software that installs them. Creators keep control of their releases.
          Users get a practical way to discover, install and update them.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#for-creators">
            I build extensions <span aria-hidden="true">↓</span>
          </a>
          <a class="button secondary" href="#for-users">
            I use extensions <span aria-hidden="true">↓</span>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <ModuleDiagram />
      </div>
    </div>
  </section>

  <section class="overview section">
    <div class="shell">
      <div class="overview-intro">
        <p class="eyebrow">The 1,000-foot view</p>
        <h2>
          A shared, open distribution layer between extension creators and
          users.
        </h2>
        <p class="overview-lead">
          Plugins, add-ons and modules are all extensions. Publishing them
          independently often means building downloads, release metadata,
          installation and updates again for every system. ExtensionMesh aims
          to turn that repeated work into open, reusable infrastructure.
        </p>
      </div>

      <div class="plain-flow" aria-label="ExtensionMesh in three steps">
        <div class="plain-flow-node">
          <span>01 · Publish</span>
          <strong>Extension creators</strong>
          <p>Release through an independent registry.</p>
        </div>
        <div class="plain-flow-link" aria-hidden="true">
          <i></i><span>ExtensionMesh</span><i></i>
        </div>
        <div class="plain-flow-node">
          <span>02 · Connect</span>
          <strong>Supported software</strong>
          <p>A connector translates what the system needs.</p>
        </div>
        <div class="plain-flow-link" aria-hidden="true">
          <i></i><span>Install &amp; update</span><i></i>
        </div>
        <div class="plain-flow-node">
          <span>03 · Use</span>
          <strong>Extension users</strong>
          <p>Choose trusted sources and use their extensions.</p>
        </div>
      </div>

      <p class="overview-boundary">
        ExtensionMesh is the connection layer—not a single catalogue, vendor or
        required source. The first implementation connects independent
        registries with Shopware; broader conventions will grow from working
        integrations.
      </p>
    </div>
  </section>

  <section class="paths section">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Choose your perspective</p>
          <h2>What does ExtensionMesh do for me?</h2>
        </div>
        <p>
          The same open infrastructure serves two very different jobs. Start
          with the side that matches yours.
        </p>
      </div>

      <div class="path-grid">
        <article id="for-creators" class="path-card creator-path">
          <div class="path-label">
            <span>For creators</span>
            <i aria-hidden="true">01</i>
          </div>
          <h3>I build extensions.</h3>
          <p class="path-summary">
            Publish releases through infrastructure you run or choose, while
            keeping packages, metadata and release decisions under your
            control.
          </p>
          <ul>
            <li>Use an independent registry as your extension source.</li>
            <li>Avoid rebuilding the full distribution workflow for every release.</li>
            <li>Reach supported systems through explicit, open connectors.</li>
          </ul>
          <a class="text-link" href={withBase("/docs/for-creators/")}>
            Follow the creator path <span aria-hidden="true">→</span>
          </a>
        </article>

        <article id="for-users" class="path-card user-path">
          <div class="path-label">
            <span>For users</span>
            <i aria-hidden="true">02</i>
          </div>
          <h3>I use extensions.</h3>
          <p class="path-summary">
            Connect sources you trust, find their extensions from the software
            you already use, and keep installed releases up to date.
          </p>
          <ul>
            <li>Choose which independent registries your system should trust.</li>
            <li>Discover and install available extensions through a connector.</li>
            <li>Receive compatible releases without tracking manual downloads.</li>
          </ul>
          <a class="text-link" href={withBase("/docs/for-users/")}>
            Follow the user path <span aria-hidden="true">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="principles section">
    <div class="shell">
      <div class="section-heading split-heading">
        <div>
          <p class="eyebrow">Project model</p>
          <h2>Distribution without a single required source.</h2>
        </div>
        <p>
          ExtensionMesh separates extension sources from system integration.
          Registries remain independent; connectors make them usable in a
          specific environment.
        </p>
      </div>

      <div class="principle-grid">
        <article>
          <span class="card-index">01</span>
          <div class="card-mark"><i></i><i></i><i></i></div>
          <h3>Independent registries</h3>
          <p>
            Registry operators control their infrastructure, publication
            process and available extensions.
          </p>
        </article>
        <article>
          <span class="card-index">02</span>
          <div class="card-mark connector-mark"><i></i><i></i><i></i></div>
          <h3>Explicit connectors</h3>
          <p>
            System-specific behavior stays in a visible integration boundary
            instead of being hidden behind broad claims.
          </p>
        </article>
        <article>
          <span class="card-index">03</span>
          <div class="card-mark open-mark"><i></i><i></i><i></i></div>
          <h3>Open development</h3>
          <p>
            Source, documentation and technical decisions are intended to be
            accessible and shaped by real implementations.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="flow section" id="how-it-works">
    <div class="shell flow-grid">
      <div class="flow-copy">
        <p class="eyebrow">How it fits together</p>
        <h2>Clear roles.<br />Practical boundaries.</h2>
        <p>
          ExtensionMesh is not presented as a finished universal standard. The
          current model grows from a working connector and the requirements of
          independent registries.
        </p>
        <a class="text-link" href={withBase("/docs/concepts/")}>
          Understand the concepts <span aria-hidden="true">→</span>
        </a>
      </div>
      <ol class="flow-list">
        <li>
          <span>01</span>
          <div>
            <h3>A registry publishes extension information.</h3>
            <p>It owns its catalogue, releases and distribution infrastructure.</p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>A connector translates system requirements.</h3>
            <p>Discovery, installation and updates are integrated where the system needs them.</p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>The implementation shapes shared conventions.</h3>
            <p>Common interfaces are extracted only when real use cases demonstrate them.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="cta-section">
    <div class="shell cta-inner">
      <div>
        <p class="eyebrow on-dark">Working vertical slice</p>
        <h2>See what works.<br />See what is not stable yet.</h2>
      </div>
      <div>
        <p>
          Buyer, seller and paid-distribution flows exist in source. The status
          page separates implemented capabilities from release promises and
          future ideas.
        </p>
        <a class="button primary" href={withBase("/docs/project-status/")}>
          View project status <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
